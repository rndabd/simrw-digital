# Environment Variables for SIM-RW Aplikasi Warga

PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aplikasi_warga?schema=public"

JWT_SECRET="your-jwt-secret-key-at-least-32-chars"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-at-least-32-chars"

DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
BLIND_INDEX_SECRET="sim-rw-blind-index-hmac-salt-secure-value"

FCM_SERVER_KEY="your-fcm-server-key"

