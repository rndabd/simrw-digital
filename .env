# Environment Variables for SIM-RW Aplikasi Warga

# Port server
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aplikasi_warga?schema=public"

# Auth Secrets
JWT_SECRET="warga-jwt-secret-key-32-chars-long-secure-random"
JWT_REFRESH_SECRET="warga-jwt-refresh-secret-key-32-chars-long"

# UU PDP Cryptography (AES-256-GCM Key must be 32 bytes / 64 hex chars)
DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
BLIND_INDEX_SECRET="sim-rw-blind-index-hmac-salt-secure-value"

# Notification / Push (Mock / FCM)
FCM_SERVER_KEY="mock-fcm-server-key"

# WhatsApp Gateway (WAHA - WhatsApp HTTP API)
# Kosongkan atau biarkan dummy untuk simulasi console aman jika belum running
WAHA_API_URL=""
WAHA_SESSION="default"
WAHA_API_KEY=""

# Email SMTP Gateway (Gmail / Brevo)
# Kosongkan untuk simulasi pengiriman email ke console server jika belum disetel
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"SIM-RW Digital" <noreply@simrw.id>'

